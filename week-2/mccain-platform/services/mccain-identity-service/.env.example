# Copy to .env and adjust for your environment.
# docker-compose.yml already sets sane defaults for local dev; this file is
# mainly for running the app outside Docker, or overriding compose defaults.

ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Postgres ---
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=identity_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- JWT ---
# CHANGE THIS in every real environment. Use `openssl rand -hex 32`.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_super_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=mccain-identity-service

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# --- Kafka ---
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_USER_EVENTS=identity.user.events

# --- gRPC ---
GRPC_ENABLED=true
GRPC_PORT=50051

# --- Security misc ---
BCRYPT_ROUNDS=12
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
